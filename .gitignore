# macOS
.DS_Store

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# PC app runtime logs (rotate to ~10 MB each — never commit)
pc_app/logs/

# Claude Code local settings (machine-specific)
.claude/settings.local.json

# Arduino build output (if arduino-cli is ever used in-tree)
build/
*.bin.tmp
.build/

# local browser-preview scratch (see .claude/launch.json)
preview/

# per-machine runtime settings (host, labels, checkboxes) — written by the app
pc_app/data/config.json

# YOLO weights — ultralytics downloads these on first use (~6 MB each).
# They land in the CWD, so running the app or tools/cv_benchmark.py from the
# repo can drop one in-tree.  Never commit them; they re-download on demand.
*.pt

# Video masters — encode to web MP4s and commit those, not the source
# (binaries never delta-compress, so a master in history is permanent weight)
docs/assets/img/*.mov
docs/assets/img/movingRail.mp4

# Camera-original HEICs — web JPGs are committed instead
docs/assets/img/Mount Hero/
