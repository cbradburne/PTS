// The rig's real WiFi AP password — copy this file to ap_secret.h and edit it.
//
//     cp firmware/shared/ap_secret.h.example firmware/shared/ap_secret.h
//     copy firmware\shared\ap_secret.h.example firmware\shared\ap_secret.h
//
// ap_secret.h is gitignored and this repository is public, so the real password
// stays on your machines and never reaches a commit. Every target that raises an
// access point picks it up automatically — hub, hub-eth and satellite — and each
// machine that flashes needs its own copy.
//
// Nothing on the rig itself needs this password: a mount SCANS for the AP and
// takes its BSSID as the ESP-NOW address without ever joining, and a satellite
// reaches the hub over Ethernet. It gates the phone, tablet or laptop you use
// for the web UI, so the rig runs whatever you set it to.
//
// Rules, all three of which fail quietly rather than loudly:
//   - at least 8 characters. WPA2 rejects anything shorter, and softAP() does
//     not fail on rejection — it brings the access point up OPEN.
//   - no double quote: it would terminate the C string.
//   - keep the #ifndef. A -D on the command line then still wins, so
//     AP_PASSWORD=... tools/build.sh can override this for a one-off build.
#ifndef AP_PASSWORD
#define AP_PASSWORD "changeme123"
#endif
